# ==============================================================================
# SPRINTS AI LEARNER SUCCESS AGENT - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Generate a secure 32+ character random API key and secrets.
# 3. Never commit '.env' to git (.gitignore protects this by default).
# ==============================================================================

# Mandatory Cryptographic API Key (Required on service boot)
SPRINTS_API_KEY=your-secure-random-32char-api-key-here
FASTAPI_API_KEY=your-secure-random-32char-api-key-here

# Webhook & Session Cryptographic Secrets (Phase 1: Security Hardening)
WEBHOOK_SECRET=your-secure-webhook-hmac-sha256-secret-here
SESSION_SECRET=your-secure-session-signing-secret-here

# Service Binding & Networking
FASTAPI_BASE_URL=http://localhost:8000
N8N_BASE_URL=http://localhost:5678

# Redis & n8n Vault Configuration
REDIS_PASSWORD=sprints_redis_vault_secret_2026
REDIS_URL=redis://:sprints_redis_vault_secret_2026@localhost:6379/0
N8N_ENCRYPTION_KEY=sprints_n8n_vault_encryption_key_2026

# Security & Traffic Controls
RATE_LIMIT_PER_MINUTE=120
MAX_PAYLOAD_SIZE=65536
TRUSTED_PROXIES=127.0.0.1,::1,localhost
