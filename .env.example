# ==============================================================================
# SPRINTS AI LEARNER SUCCESS AGENT - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this template: cp .env.example .env
# 2. Generate cryptographically strong random secrets for each deployment:
#      openssl rand -hex 32
# 3. Fill all mandatory variables below.
# 4. NEVER commit '.env' to git (.gitignore enforces this).
# ==============================================================================

# Mandatory Cryptographic API Keys (Min 32 characters hex)
# Command: openssl rand -hex 32
SPRINTS_API_KEY=GENERATE_SECURE_32_CHAR_HEX_API_KEY
FASTAPI_API_KEY=GENERATE_SECURE_32_CHAR_HEX_API_KEY

# Webhook & Session Cryptographic Secrets (Phase 1: Security Hardening)
# Command: openssl rand -hex 32
WEBHOOK_SECRET=GENERATE_SECURE_32_CHAR_HEX_WEBHOOK_SECRET
SESSION_SECRET=GENERATE_SECURE_32_CHAR_HEX_SESSION_SECRET

# Service Binding & Networking
FASTAPI_BASE_URL=http://localhost:8000
N8N_BASE_URL=http://localhost:5678

# Redis & n8n Vault Configuration (Mandatory: Zero-Default Security)
# Command: openssl rand -hex 32
REDIS_PASSWORD=GENERATE_SECURE_32_CHAR_HEX_REDIS_PASSWORD
REDIS_URL=redis://:GENERATE_SECURE_32_CHAR_HEX_REDIS_PASSWORD@localhost:6379/0
N8N_ENCRYPTION_KEY=GENERATE_SECURE_32_CHAR_HEX_N8N_VAULT_KEY

# Security & Traffic Controls
ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=120
MAX_PAYLOAD_SIZE=65536
TRUSTED_PROXIES=127.0.0.1,::1,localhost
